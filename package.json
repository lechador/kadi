{
  "name": "kadi-program",
  "version": "0.1.0",
  "private": true,
  "description": "Anchor workspace for the Kadi donation program",
  "scripts": {
    "build:program": "bash scripts/build-program.sh",
    "test": "npm run build:program && npm run test:fast",
    "test:fast": "PATH=\"$HOME/.local/share/solana/install/active_release/bin:$HOME/.cargo/bin:$PATH\" anchor test --skip-build",
    "localnet": "PATH=\"$HOME/.local/share/solana/install/active_release/bin:$PATH\" solana-test-validator --reset",
    "localnet:up": "bash scripts/localnet-up.sh",
    "localnet:down": "pkill -f solana-test-validator || true",
    "deploy:localnet": "PATH=\"$HOME/.local/share/solana/install/active_release/bin:$HOME/.cargo/bin:$PATH\" anchor deploy",
    "devnet:deploy": "bash scripts/deploy-devnet.sh",
    "seed": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} npx ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/seed.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.9",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.1.0",
    "typescript": "^5.9.2"
  }
}
