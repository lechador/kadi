# RPC the browser talks to. Localnet by default.
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_SOLANA_WS_URL=ws://127.0.0.1:8900

# Wallet Standard chain id: solana:localnet | solana:devnet | solana:mainnet
NEXT_PUBLIC_SOLANA_CHAIN=solana:localnet

# Public origin, used to build Solana Pay links and OBS overlay URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mint offered as a stablecoin denomination for goals. Devnet and mainnet fall
# back to Circle's USDC automatically; localnet needs the stand-in that
# `npm run seed` mints (its address is fixed and printed by the script).
NEXT_PUBLIC_USDC_MINT=Cdkrk8tujFY6mTyGwFgKpnbiGc1hqtXCog1qvUdKAe6D
