# RPC the browser talks to. Localnet by default.
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_SOLANA_WS_URL=ws://127.0.0.1:8900

# Wallet Standard chain id: solana:localnet | solana:devnet | solana:mainnet
NEXT_PUBLIC_SOLANA_CHAIN=solana:localnet

# Public origin, used to build Solana Pay links and OBS overlay URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mint offered as a stablecoin denomination for goals. Devnet and mainnet fall
# back to Circle's USDC automatically; localnet needs the stand-in that
# `npm run seed` mints (its address is fixed and printed by the script).
NEXT_PUBLIC_USDC_MINT=Cdkrk8tujFY6mTyGwFgKpnbiGc1hqtXCog1qvUdKAe6D

# ---------------------------------------------------------------------------
# Read cache (optional)
#
# Kadi runs without it: every page falls back to reading the chain directly.
# What it buys is a landing page, a search and a leaderboard that do not each
# cost a `getProgramAccounts` scan, which hosted RPCs throttle.
#
# Create a project at https://neon.tech and paste its connection string. Any
# Postgres works — the driver switches to Neon's HTTP transport automatically
# when the host is a *.neon.tech one.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/kadi?sslmode=require

# Signs the wallet session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Guards /api/sync so only your cron can trigger an index run. Either name
# works and either value is accepted, so setting both is safe.
#
# On Vercel, name it CRON_SECRET: the platform populates its scheduler's
# `Authorization: Bearer …` header from that variable specifically. Elsewhere
# INDEXER_SECRET reads better; pass it as the same bearer header or as
# `?secret=`.
#
# In production, no secret means /api/sync refuses every caller — the index
# stops updating rather than the endpoint becoming public. In development it is
# open when unset.
INDEXER_SECRET=
CRON_SECRET=

# RPC the *server* uses for indexing, kept out of the client bundle. The
# indexer is what makes the throttled calls, so this is where a Helius or
# Triton endpoint belongs. Falls back to NEXT_PUBLIC_SOLANA_RPC_URL.
SOLANA_RPC_URL=
